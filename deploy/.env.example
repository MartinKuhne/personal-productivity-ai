# ==============================================================================
# FastMD Infrastructure Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Qdrant Vector Database
# ------------------------------------------------------------------------------
# Qdrant image version tag
QDRANT_VERSION=v1.13.4

# Qdrant HTTP REST API & Web Dashboard Port
# Web Dashboard: http://localhost:6333/dashboard
QDRANT_REST_PORT=6333

# Qdrant gRPC Port (used by qdrant-client in FastMD)
QDRANT_GRPC_PORT=6334

# Optional: API key for authentication. Leave blank for unauthenticated local development.
QDRANT_API_KEY=

# Log level: TRACE, DEBUG, INFO, WARN, ERROR
QDRANT_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# SearXNG Metasearch Engine
# ------------------------------------------------------------------------------
# SearXNG image version tag
SEARXNG_VERSION=latest

# SearXNG Web UI & JSON API Port
SEARXNG_PORT=3001

# Public URL of the SearXNG instance
SEARXNG_BASE_URL=http://localhost:3001/

# ==============================================================================
# FastMD Desktop Application Integration Settings
# ==============================================================================
# Vector search service endpoint
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=fastmd_chunks

# Web search tool endpoint (matches AppConfig::searxng_url)
SEARXNG_URL=http://localhost:3001
