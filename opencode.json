{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "rust-analyzer": {
            "type": "local",
            "command": [
                "rust-analyzer-mcp"
            ],
            "enabled": false
        },
        "codegraph": {
          "type": "local",
          "command": [
            "codegraph",
            "serve",
            "--mcp"
          ],
          "enabled": true
        },
        "egui_mcp": {
            "type": "local",
            "command": [
                "egui-mcp"
            ],
            "enabled": false
        }
    }
}